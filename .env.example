# ═══════════════════════════════════════════════════════════════════════════
# SOLO infraestructura vive en env. Credenciales de WhatsApp (tokens, app
# secret, verify token, phone_number_id, waba_id) viven en la BASE, cifradas.
# Las SEED_* de abajo se leen UNA vez durante `npm run db:seed` para cifrarlas
# y guardarlas en Postgres; el runtime jamás las lee de acá.
# ═══════════════════════════════════════════════════════════════════════════

# App
PORT=3001

# Postgres (rol app_user, NO superusuario — ver README sección RLS)
DATABASE_URL=postgresql://app_user:app_password@localhost:5434/whatsapp_inbox

# Redis (BullMQ, fase 2+)
REDIS_URL=redis://localhost:6380

# Cifrado en reposo (AES-256-GCM). 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Equivale a la versión 1. Para rotación: ENCRYPTION_KEYS='{"1":"...","2":"..."}'
# + ENCRYPTION_ACTIVE_KEY_VERSION=2 (las versiones viejas quedan para descifrar).
ENCRYPTION_KEY=
# ENCRYPTION_KEYS=
# ENCRYPTION_ACTIVE_KEY_VERSION=1

# Retención de WebhookEvent (días). PROCESSED/DISCARDED más viejos se purgan;
# FAILED se conservan hasta revisión manual.
WEBHOOK_RETENTION_DAYS=60

# ── Credenciales para el SEED (una sola vez, se cifran a la base) ──────────
# Meta App (modelo Tech Provider: UNA app para todos los tenants)
SEED_META_APP_ID=
SEED_META_APP_SECRET=
SEED_WEBHOOK_VERIFY_TOKEN=

# Cuenta de WhatsApp de Nova Sushi
SEED_WA_PHONE_NUMBER_ID=
SEED_WA_WABA_ID=
SEED_WA_DISPLAY_PHONE=
SEED_WA_ACCESS_TOKEN=

# Datos del tenant
SEED_OWNER_EMAIL=
SEED_MENU_URL=
