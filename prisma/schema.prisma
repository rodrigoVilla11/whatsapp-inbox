generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// PLATAFORMA — no lleva tenantId a propósito.
// El app secret y el verify token son de la Meta App (modelo Tech
// Provider: una sola app, todos los WABAs cuelgan de ella), no del
// tenant. La firma del webhook se valida ANTES de poder resolver el
// tenant desde el payload.
// ═══════════════════════════════════════════════════════════════════

model MetaApp {
  id             String   @id @default(cuid())
  ref            String   @unique // id público para /webhooks/whatsapp/:ref (caso multi-app)
  name           String
  appId          String   @unique // Meta App ID
  appSecretEnc   String // AES-256-GCM, envelope v1.<kv>.<iv>.<tag>.<ct>
  verifyTokenEnc String // hub.verify_token — NO en .env
  keyVersion     Int      @default(1)
  graphVersion   String? // override opcional de GRAPH_API_VERSION
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts WhatsappAccount[]
}

// ═══════════════════════════════════════════════════════════════════
// TENANT
// ═══════════════════════════════════════════════════════════════════

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // "nova-sushi"
  name      String
  timezone  String       @default("America/Argentina/Buenos_Aires")
  status    TenantStatus @default(ACTIVE)
  // Provisioning desde Gourmetify: id del cliente en el SaaS. La API de
  // provisioning es idempotente por este campo.
  gourmetifyTenantId String? @unique

  // Auto-respuesta fuera de horario: { enabled, message, schedule } —
  // schedule por día de semana (0=Dom..6=Sáb) con hasta 2 rangos HH:MM.
  // Se interpreta SIEMPRE en el timezone del tenant.
  autoReply Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // FUTURO Gourmetify: id del tenant en el SaaS, para unificar sin migrar PKs
  // gourmetifyTenantId String? @unique

  whatsappAccounts WhatsappAccount[]
  users            User[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  templates        MessageTemplate[]
  quickReplies     QuickReply[]
  gourmetifyOrders GourmetifyOrder[]
  tags             Tag[]
}

model WhatsappAccount {
  id        String @id @default(cuid())
  tenantId  String
  metaAppId String

  wabaId             String // NO único: un WABA puede tener varios números
  phoneNumberId      String  @unique // ÚNICO GLOBAL — clave de ruteo del webhook
  displayPhoneNumber String
  verifiedName       String?
  qualityRating      String?

  accessTokenEnc String // cifrado en reposo
  keyVersion     Int       @default(1)
  tokenExpiresAt DateTime?

  status        WhatsappAccountStatus @default(PENDING)
  lastErrorCode Int?
  lastErrorAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metaApp       MetaApp           @relation(fields: [metaAppId], references: [id])
  conversations Conversation[]
  messages      Message[]
  templates     MessageTemplate[]

  @@index([tenantId])
  @@index([wabaId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String? // argon2id; null = todavía no puede loguearse
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  // Alta por un admin: password inicial comunicada por fuera → cambio
  // forzado en el primer login.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Mapeo al usuario del SaaS al integrar con Gourmetify.
  // La tabla se MANTIENE (no se descarta): mapear vía este campo no toca
  // ninguna fila del histórico de assignedUserId.
  gourmetifyUserId String? @unique

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("AssignedAgent")
  sessions              Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Sesión por cookie (fase 8). El id que viaja en la cookie es un token
// opaco de 256 bits que acá se guarda HASHEADO (sha256): un dump de la
// tabla no sirve para fabricar cookies. Expiración sliding de 30 días.
// Fuera del tenant-guard a propósito: la sesión se busca por tokenHash
// ANTES de conocer el tenant (igual que User en el login).
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  tenantId   String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // "cerrar todas las sesiones" del usuario
  @@index([expiresAt]) // barrido de vencidas
}

// ═══════════════════════════════════════════════════════════════════
// DOMINIO DEL INBOX — todo lleva tenantId, indexado, desde el día uno
// ═══════════════════════════════════════════════════════════════════

model Contact {
  id          String    @id @default(cuid())
  tenantId    String
  waId        String // tal cual lo manda Meta (E.164 sin '+')
  phoneE164   String? // normalizado, para cruzar con Customer
  profileName String?
  notes       String?
  isBlocked   Boolean   @default(false)
  deletedAt   DateTime? // soft delete — las lecturas del dominio filtran null por defecto
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // FUTURO Gourmetify: sin FK todavía, se resuelve por phoneE164 y se cachea acá
  customerId String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, waId])
  @@index([tenantId, customerId])
  @@index([tenantId, phoneE164])
}

model Conversation {
  id                String @id @default(cuid())
  tenantId          String
  whatsappAccountId String
  contactId         String

  status         ConversationStatus @default(OPEN)
  assignedUserId String?

  lastInboundAt      DateTime? // ← ventana de 24h
  lastOutboundAt     DateTime?
  lastAutoReplyAt    DateTime? // cooldown de la auto-respuesta (máx 1 cada 6h)
  lastMessageAt      DateTime? // orden del inbox
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  // Anclado COMPARTIDO por todo el equipo: si la cajera ancla, el dueño
  // también lo ve arriba. La fecha (y no un boolean) da el orden entre
  // varios anclados: el último anclado va primero.
  pinnedAt           DateTime?
  deletedAt          DateTime? // soft delete
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // FUTURO Gourmetify: pedido asociado a la charla
  orderId String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id])
  contact         Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser    User?           @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]
  tags            ConversationTag[]

  @@unique([tenantId, whatsappAccountId, contactId])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assignedUserId, lastMessageAt(sort: Desc)])
  @@index([tenantId, lastInboundAt])
  @@index([tenantId, orderId])
  // Los anclados se piden aparte en cada listado: van arriba de todo.
  @@index([tenantId, pinnedAt(sort: Desc)])
}

// Pedido de Gourmetify espejado en el inbox (ingesta por webhook, fase
// "pedidos en el chat"). Contrato display-ready: los *Label son texto listo
// para mostrar; statusKind es lo ÚNICO que el inbox interpreta.
model GourmetifyOrder {
  id                String   @id @default(cuid())
  tenantId          String
  gourmetifyOrderId String
  contactId         String? // se linkea por teléfono cuando el contacto existe
  customerPhone     String // dígitos internacionales (formato waId)
  number            String?
  statusLabel       String
  statusKind        String // pending | in_progress | ready | done | cancelled
  summary           String?
  totalLabel        String?
  deliveryLabel     String?
  scheduledLabel    String?
  orderCreatedAt    DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, gourmetifyOrderId])
  @@index([tenantId, contactId])
  @@index([tenantId, customerPhone])
}

model Message {
  id                String @id @default(cuid())
  tenantId          String
  conversationId    String
  whatsappAccountId String

  wamid          String? // null mientras está PENDING (antes de llamar a Meta)
  clientDedupKey String? // idempotencia del envío (retry de BullMQ)
  direction      MessageDirection
  type           MessageType      @default(UNSUPPORTED)
  status         MessageStatus    @default(PENDING)

  body         String?
  replyToWamid String?

  // Plantillas
  templateName     String?
  templateLanguage String?
  templateParams   Json?

  // Media (se completa en el worker, después de subir a R2)
  mediaId        String? // media_id de Meta
  mediaUrl       String? // URL en R2
  mediaMimeType  String?
  mediaFilename  String?
  mediaSizeBytes Int?
  mediaSha256    String?
  mediaStatus    MediaStatus?
  // Transcripción del audio (Whisper vía Groq, bajo demanda; se paga y
  // transcribe UNA vez, después queda cacheada acá).
  transcription  String?
  // true = lo mandó el sistema (auto-respuesta), no una persona.
  isAutoReply    Boolean      @default(false)

  // Pricing (objeto pricing de statuses[] — desde oct 2026 Meta cobra
  // mensajes de servicio; sin esto no hay backfill posible).
  // Strings tal cual los manda Meta, SIN enums propios: las categorías
  // cambian con cada actualización de pricing.
  billable        Boolean?
  pricingModel    String?
  pricingCategory String?
  pricingType     String?

  // Errores de Meta
  errorCode   Int?
  errorTitle  String?
  errorDetail String?

  sentByUserId String?
  timestamp    DateTime // el que manda Meta
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  deletedAt    DateTime? // soft delete

  // SOLO se persiste cuando type = UNSUPPORTED o errorCode != null.
  // Para el resto queda null: el payload original vive en WebhookEvent
  // hasta su purga. No duplicar todo el contenido en la tabla más caliente.
  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id])

  @@unique([tenantId, wamid])
  @@unique([tenantId, clientDedupKey])
  @@index([wamid]) // lookup global para soporte/tickets con Meta (el unique compuesto no sirve para buscar por wamid a secas)
  @@index([tenantId, conversationId, timestamp(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, mediaStatus])
  @@index([tenantId, billable, timestamp]) // "cuánto gastó este tenant este mes" con index scan
}

model MessageTemplate {
  id                String         @id @default(cuid())
  tenantId          String
  whatsappAccountId String
  name              String
  language          String
  category          String
  status            TemplateStatus @default(PENDING)
  bodyText          String
  components        Json?
  variableCount     Int            @default(0)
  metaTemplateId    String?
  syncedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, whatsappAccountId, name, language])
  @@index([tenantId, status])
}

// (isFavorite: hasta 4 por tenant aparecen como chips arriba del composer)
model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  shortcut  String // "/carta"
  title     String
  body      String // el link del menú vive ACÁ, no en el código
  isActive  Boolean  @default(true)
  isFavorite Boolean @default(false) // chip arriba del composer (máx 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
}

// Etiquetas de conversación ("mayorista", "reclamo", "sin gluten"). Datos
// por tenant, igual que las respuestas rápidas: cualquier agente puede
// crear una al aplicarla desde el chat; renombrar/recolorear/borrar es
// ADMIN+ desde Ajustes.
model Tag {
  id       String @id @default(cuid())
  tenantId String
  name     String // como la escribió quien la creó ("Sin Gluten")
  // Normalizado (minúsculas, sin acentos ni espacios de más): es lo que
  // hace único a una etiqueta y evita "Mayorista" vs "mayorista".
  slug     String
  // Token de color de la paleta de etiquetas (ver web globals.css). NO se
  // usa `gari`: está reservado a urgencia.
  color    String @default("piedra")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([tenantId, slug])
  @@index([tenantId, name])
}

// Join explícito (no relación implícita de Prisma) por dos razones: lleva
// tenantId para que el guard de tenant pueda filtrar sin join, y lleva
// createdAt para poder mostrar las etiquetas en orden de aplicación.
model ConversationTag {
  conversationId String
  tagId          String
  tenantId       String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tenantId, tagId])
  @@index([tenantId, conversationId])
}

// Auditoría de todo lo que llega al webhook. tenantId nullable: acá cae
// el caso "no encontré la cuenta por phone_number_id, logueo y descarto
// con 200". Se purga por job (WEBHOOK_RETENTION_DAYS); FAILED se conserva.
model WebhookEvent {
  id                String             @id @default(cuid())
  metaAppId         String?
  tenantId          String? // null = no se pudo resolver el tenant
  whatsappAccountId String?
  phoneNumberId     String?
  signatureValid    Boolean
  status            WebhookEventStatus @default(RECEIVED)
  payload           Json
  error             String?
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?

  @@index([tenantId, receivedAt])
  @@index([phoneNumberId, receivedAt])
  @@index([status, receivedAt])
}

// ═══════════════════════════════════════════════════════════════════

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum WhatsappAccountStatus {
  PENDING
  ACTIVE
  TOKEN_EXPIRED
  DISCONNECTED
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaStatus {
  PENDING
  DOWNLOADED
  FAILED
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSED
  DISCARDED
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  TEMPLATE
  INTERACTIVE
  BUTTON
  REACTION
  SYSTEM
  UNSUPPORTED
}
